# runc bats integration test pattern for takoyaki
#
# Each line is either a test name to run, or prefixed with [skip] to skip.
# Blank lines and lines starting with # are ignored.
#
# Categories of skips:
#   criu         checkpoint/restore not implemented
#   systemd      systemd cgroup manager not supported
#   cgroups_v1   test only valid on cgroups v1
#   rootless     rootless-specific (not yet tested)
#   selinux      requires SELinux enabled
#   sshfs        requires sshfs fuse mount
#   hang         test hangs with takoyaki
#   unimpl       feature not yet implemented in takoyaki
#   arch         architecture-specific (i386/x86_64 personality)

# --- spec ---
spec generation cwd
spec generation --bundle

# --- version / help ---
runc version
runc -h
runc command -h
runc foo -h

# --- debug / logging ---
global --debug
global --debug to --log
global --debug to --log --log-format 'json'
global --debug to --log --log-format 'text'
global --root

